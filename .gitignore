# Rendered output and caches -- regenerate with `quarto render`
*.html
*_files/
.quarto/
**/*.quarto_ipynb

# Generated decks. The reference doc is the exception: it is a build artefact of
# tools/build_reference_pptx.py, but decks need it without running the build.
*.pptx
!_extensions/nexer/nexer-reference.pptx

# Rendered PDF (chrome --print-to-pdf), a build output like the others above
*.pdf

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# R
.Rhistory
.RData
.Rproj.user/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Office lock files
~$*

# Written by Quarto with an absolute path to the local Quarto install.
/.luarc.json

# Source material the kit was derived from: the Nexer corporate deck, the
# co-branding guidelines and the McKinsey reports. Deliberately not in the repo
# -- ~108 MB, and nothing at render time needs them.
/temp/
/temp-mckinsey/
/temp-jonathan-slides-example/

/.quarto/
